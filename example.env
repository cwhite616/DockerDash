# Copy this file to .env and edit the values

# Optional: auth mode. "password" (default) requires the PASSWORD below.
# "none" disables login entirely - use only for local/trusted environments.
AUTH=password

# Required when AUTH=password: dashboard login password
PASSWORD=changeme

# Required: any random secret string for JWT signing
JWT_SECRET=please-change-me

# Optional: backend listen port (compose maps 8080:8080)
PORT=8080
